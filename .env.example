# ==============================================================================
# PROCURA — ENVIRONMENT CONFIGURATION & DEPLOYMENT SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------

# Server Runtime
PORT=5000
NODE_ENV=production

# CORS Allowed Origin (Vercel Frontend URL)
# Set this to your live Vercel domain. Supports comma-separated origins for preview URLs:
# e.g. CLIENT_URL=https://procura.vercel.app,https://procura-git-main.vercel.app
CLIENT_URL=https://procura.vercel.app

# Google Gemini API
# Obtain from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# PayPal Developer REST API (STRICT SANDBOX MODE)
# Obtain from PayPal Developer Dashboard (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------

# Render Backend URL
# Set this in Vercel -> Project Settings -> Environment Variables.
# Leave blank for local development to use Vite's internal proxy.
VITE_API_URL=https://procura-backend.onrender.com

# ------------------------------------------------------------------------------
# 3. SECURITY & PERSISTENCE NOTICE
# ------------------------------------------------------------------------------
# - CRITICAL: Never prefix backend secrets with VITE_ or expose GEMINI_API_KEY /
#   PAYPAL_CLIENT_SECRET in client-side code. All AI and PayPal authorization runs server-side.
# - RENDER FREE TIER STORAGE: On the Render Free tier, the local filesystem is
#   ephemeral and spins down after periods of inactivity. Runtime JSON transactions
#   are stored on disk during active execution, but require a persistent disk (paid tier)
#   or managed database for persistent multi-instance production deployment.
